{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supralinux.github.io/psd/spec/plugins.schema.json",
  "title": "PSD Plugin Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "type",
    "entry"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "apiVersion": {
      "type": "string",
      "const": "0.1"
    },
    "type": {
      "enum": [
        "surface-widget",
        "wallpaper-provider",
        "desktop-provider",
        "search-provider",
        "launcher-provider",
        "control-provider",
        "notification-provider",
        "ai-provider",
        "automation-provider"
      ]
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "configSchema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
