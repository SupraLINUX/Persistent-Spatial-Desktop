{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supralinux.github.io/psd/spec/ipc.schema.json",
  "title": "PSD IPC Envelope",
  "type": "object",
  "required": [
    "version",
    "kind",
    "name"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.1"
    },
    "kind": {
      "enum": [
        "request",
        "response",
        "event",
        "error"
      ]
    },
    "id": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "payload": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
